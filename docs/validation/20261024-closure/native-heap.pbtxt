buffers {
  size_kb: 32768
  fill_policy: DISCARD
}
duration_ms: 360000
data_sources {
  config {
    name: "android.heapprofd"
    heapprofd_config {
      sampling_interval_bytes: 8192
      process_cmdline: "dev.ccrouter.demo"
      shmem_size_bytes: 8388608
      block_client: false
      continuous_dump_config {
        dump_phase_ms: 0
        dump_interval_ms: 30000
      }
    }
  }
}
