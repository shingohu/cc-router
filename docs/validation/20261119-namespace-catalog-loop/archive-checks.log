$ python3 - <<'PY'
from pathlib import Path
import hashlib,json,subprocess
manifest=json.loads(Path('docs/validation/20261119-namespace-catalog-loop/source-manifest.json').read_text())
bad=[p for p,h in manifest['files'].items() if not Path(p).is_file() or hashlib.sha256(Path(p).read_bytes()).hexdigest()!=h]
print(f"Manifest: {len(manifest['files'])} files checked, {len(bad)} mismatches")
assert not bad,bad
names=subprocess.check_output(['git','ls-files','--others','--exclude-standard','-z']).decode().split('\0')
bad=[]
count=0
for name in names:
 p=Path(name)
 if not name or not p.is_file() or p.suffix not in {'.dart','.md','.json','.log'}: continue
 count+=1
 for i,line in enumerate(p.read_text().splitlines(),1):
  if line.rstrip(' \t')!=line: bad.append(f'{name}:{i}')
print(f'Untracked whitespace: {count} files checked, {len(bad)} issues')
assert not bad,bad
for label,args in [('Demo Git status',['git','status','--short','--','demo']),('Dependency file diff',['git','diff','--name-only','--','*pubspec*','*lock*'])]:
 value=subprocess.check_output(args,text=True).strip()
 print(label+': '+(value or 'clean'))
 assert not value
